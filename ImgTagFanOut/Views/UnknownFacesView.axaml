<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:resources="clr-namespace:ImgTagFanOut.Resources"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:ImgTagFanOut.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="ImgTagFanOut.Views.UnknownFacesView"
             x:DataType="vm:UnknownFacesViewModel">
    <Design.DataContext>
        <vm:UnknownFacesViewModel />
    </Design.DataContext>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding RefreshCommand}">
                <StackPanel Classes="withIcon">
                    <materialIcons:MaterialIcon Kind="AccountSearch" Classes="toolIcon" />
                    <TextBlock Text="{x:Static resources:Resources.FindUnknownFaces}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Classes="status"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{x:Static resources:Resources.UnknownFacesHint}"
                   Classes="status" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="{x:Static resources:Resources.NoUnknownFaces}"
                   IsVisible="{Binding IsEmpty}" Margin="0,12,0,0" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Clusters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnknownClusterViewModel">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8"
                                Margin="0,8,8,0" Width="200">
                            <StackPanel Spacing="6">
                                <Image Source="{Binding Image}" Height="110" Stretch="UniformToFill" />
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                                <TextBox Text="{Binding PersonName, Mode=TwoWay}"
                                         PlaceholderText="{x:Static resources:Resources.Person}" />
                                <Button Content="{x:Static resources:Resources.NameCluster}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[ItemsControl].((vm:UnknownFacesViewModel)DataContext).NameClusterCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
