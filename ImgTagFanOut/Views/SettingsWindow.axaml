<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="320"
        x:Class="ImgTagFanOut.Views.SettingsWindow"
        WindowStartupLocation="CenterOwner"
        Width="620"
        Height="320"
        xmlns:vm="using:ImgTagFanOut.ViewModels"
        xmlns:resources="clr-namespace:ImgTagFanOut.Resources"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/logo.ico"
        Title="{x:Static resources:Resources.AdvancedSettings}">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:SettingsViewModel />
    </Design.DataContext>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="CancelButton" Content="{x:Static resources:Resources.Cancel}" Margin="5" Command="{Binding CancelCommand}" />
            <Button Name="SaveButton" Content="{x:Static resources:Resources.Save}" Margin="5" Command="{Binding SaveCommand}" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{x:Static resources:Resources.PublicationSection}" FontWeight="Bold" />
            <CheckBox Name="HardLinkCheckBox" IsChecked="{Binding UseHardLinks}" Content="{x:Static resources:Resources.UseHardLinks}" Margin="0,10,0,4" />
            <TextBlock Text="{x:Static resources:Resources.UseHardLinksHint}" TextWrapping="Wrap" Opacity="0.8" Margin="24,0,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
